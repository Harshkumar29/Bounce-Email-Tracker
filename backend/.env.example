# Copy this file to .env and fill in real values. Never commit the real .env.

# Neon (or any Postgres) connection string.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require&channel_binding=require

# Shared secret the Python sender/poller must present as x-api-key to call
# the mutating endpoints (export, delivered/bounced/spam reporting).
API_KEY=dev-local-api-key

# Host embedded into every tracking pixel/link/unsubscribe URL. Must be
# reachable by recipients' mail clients — see SETUP.md Step 2.
PUBLIC_BASE_URL=http://localhost:3000

# AES-256 key (64 hex chars) encrypting the tracking token embedded in every
# pixel/click/unsubscribe URL. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Set explicitly (rather than leaving auto-generated) on any host where you
# want tracking links to survive a redeploy.
TRACKING_SECRET=

# --- Sending campaigns (app/mailer.py) — the UI's "Create Campaign" button
# both creates the record AND triggers the send, no separate script needed.
# Plain SMTP. Point this at your own mail server (see SETUP.md) for
# unrestricted sending, or any account's SMTP credentials for testing —
# note Render blocks outbound SMTP outright and Railway restricts it
# unreliably, so this needs a host that actually permits SMTP egress.
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-smtp-password
SMTP_USE_TLS=1

# --- Application login + per-user connected mailboxes (auth.py, oauth/) ---

# AES-256 key (64 hex chars) encrypting OAuth access/refresh tokens at
# rest. Separate from TRACKING_SECRET on purpose — rotating one shouldn't
# invalidate the other. Generate the same way as TRACKING_SECRET above.
OAUTH_ENCRYPTION_KEY=

# Set to 0 only for local http://localhost testing — real browsers refuse
# to store a Secure cookie over plain HTTP. Leave unset (defaults to
# Secure) on any https:// deployment.
COOKIE_SECURE=1

# Google OAuth client (Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID -> Web application). Authorized redirect
# URI must be exactly: <PUBLIC_BASE_URL>/oauth/google/callback
# Leave both unset to disable Google connections (returns a clean 400).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
