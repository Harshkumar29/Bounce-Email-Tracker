# Copy this file to .env and fill in real values. Never commit the real .env.

# Must match PUBLIC_BASE_URL configured on the Node tracker server —
# this is the host embedded in tracking pixel/click/unsubscribe links.
API_BASE=http://localhost:3000

# Must match API_KEY configured on the Node tracker server.
API_KEY=dev-local-api-key

# SMTP credentials for the mailbox that will actually send the campaign.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=harshkumarver@gmail.com
SMTP_PASS='adha cpvo fhos lufr'
SMTP_USE_TLS=1

# --- bounce_poller.py (async bounce detection) ---
# Reads the same mailbox's inbox for Delivery Status Notification emails.
# Defaults to IMAP_USER=SMTP_USER / IMAP_PASS=SMTP_PASS if left unset —
# only set these if the bounce-receiving mailbox differs from the sender.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# IMAP_USER=your-sending-address@gmail.com
# IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
